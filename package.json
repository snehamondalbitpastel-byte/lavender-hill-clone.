{
  "name": "lavender-hill-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "build:deploy": "prisma generate && next build",
    "start:deploy": "prisma db push --skip-generate && npm run seed:if-empty && next start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "bcryptjs": "^3.0.3",
    "country-flag-icons": "^1.6.20",
    "jose": "^6.2.4",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
